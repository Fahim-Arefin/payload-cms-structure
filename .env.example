# Application
API_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URI=mongodb://username:password@localhost:27017/database?authSource=admin

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_MAIL_FROM=no-reply@example.com

# Object storage
USE_S3_STORAGE=false
S3_BUCKET_NAME=example-bucket
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_REGION=example-region

# Notification recipients
CAREER_MAIL=careers@example.com
AGENT_CAREER_MAIL=agents@example.com
SUPPORT_MAIL=support@example.com
PURCHASE_MAIL=purchases@example.com
ADDITIONAL_EMAIL=additional@example.com

# Public application settings
NEXT_PUBLIC_STATIC_IMG_DOMAIN=/assets
NEXT_PUBLIC_EMAIL_PROVIDER=outlook

# Microsoft Graph email provider
MS_TENANT_ID=replace-with-tenant-id
MS_CLIENT_ID=replace-with-client-id
MS_CLIENT_SECRET=replace-with-client-secret
MS_SENDER_EMAIL=sender@example.com
